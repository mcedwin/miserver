# Mi Server - Panel de control
Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
	RewriteEngine On

	# Si la app se sirve desde una subcarpeta, descomenta y ajusta:
	# RewriteBase /

	# No reescribir archivos o directorios reales (assets, favicon...)
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d

	# Enviar todo al front controller
	RewriteRule ^([\s\S]*)$ index.php [L,QSA]
</IfModule>