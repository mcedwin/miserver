#!/bin/bash
# =============================================================================
# miserver-ctl — wrapper privilegiado para el panel Mi Server
#
# Se instala en /usr/local/sbin/miserver-ctl (root:root, 0755).
# El panel (usuario 'miserver') SOLO puede ejecutar ESTE script via sudo
# (ver /etc/sudoers.d/miserver), nunca comandos arbitrarios.
#
# Seguridad:
#  * Cada argumento se valida contra listas blancas estrictas.
#  * No hay "comando libre" ni uso de eval; las opciones del sistema
#    (Apache/MySQL/certbot) se llaman con nombres fijos.
#  * La salida es breve y las operaciones se registran en /var/log/miserver.
# =============================================================================
set -euo pipefail

LOG_DIR=/var/log/miserver
mkdir -p "$LOG_DIR"
install -d -o miserver -g miserver -m 0770 "$LOG_DIR/jobs" 2>/dev/null || true
log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >> "$LOG_DIR/ops.log" 2>/dev/null || true; }
die() { echo "error: $*" >&2; exit 2; }

[ "$#" -ge 1 ] || die "uso: miserver-ctl <comando> [args]"
cmd="$1"; shift

# -----------------------------------------------------------------------------
# Validadores (listas blancas)
# -----------------------------------------------------------------------------
re_user='^[a-z_][a-z0-9_-]{1,31}$'
re_dom='^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,}$'
re_name='^[a-z0-9_]{1,64}$'

vuser() { [ $# -ge 1 ] && [[ "$1" =~ $re_user ]] || die "usuario no valido"; }
vdom()  { [ $# -ge 1 ] && [[ "$1" =~ $re_dom ]]  || die "dominio no valido"; }
vname() { [ $# -ge 1 ] && [[ "$1" =~ $re_name ]] || die "nombre no valido"; }

# vpass: solo longitud (8-72). Se excluyen ' y \ (rompen la sentencia MySQL del wrapper).
vpass() {
  [ $# -ge 1 ] || die "contrasena invalida"
  local p="$1"
  if [ ${#p} -lt 8 ] || [ ${#p} -gt 72 ]; then die "la contrasena debe tener entre 8 y 72 caracteres"; fi
  case "$p" in
    *\'*) die "la contrasena no puede contener comillas simples" ;;
    *\"*) die "la contrasena no puede contener comillas dobles" ;;
    *\\*) die "la contrasena no puede contener backslash" ;;
  esac
}

# setpw_linux <usuario> <pass>: cifra con SHA-512 y asigna con usermod -p para
# evitar PAM (pam_pwquality rechaza contrasenas simples con "Authentication
# token manipulation error").
setpw_linux() {
  local u="$1" p="$2" h
  h=$(printf '%s' "$p" | openssl passwd -6 -stdin) || die "no se pudo cifrar la contrasena"
  usermod -p "$h" "$u"
}

# Ruta relativa (home o carpeta de dominio): sin absolutas, sin '..', sin bytes de
# control, max. 255. Se permiten espacios, acentos y UTF-8 ("Mi Carpeta", "foto n.jpg").
# La seguridad no depende del juego de caracteres: los argumentos llegan como argv
# (proc_open desde PHP; nunca se interpolan en un shell) y toda ruta pasa por
# fs_check (no atraviesa symlinks fuera del home).
vrel() {
  local r="$1"
  [ -n "$r" ] || die "ruta vacia"
  [ ${#r} -le 255 ] || die "ruta demasiado larga"
  [[ "$r" != /* ]] || die "ruta absoluta no permitida"
  [[ "$r" != *'..'* ]] || die "'..' no permitido"
  case "$r" in
    *[[:cntrl:]]*) die "caracter de control en la ruta" ;;
  esac
}

# Aplicaciones desde GitHub: solo https (sin credenciales embebidas). El patrón se
# mantiene en una variable (no literal) para que $, &, ( ) no se expandan en [[ =~ ]].
re_url='^https://[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z]{2,})+(/[a-z0-9._~!$&()*+,;=:@%-]+)+$'
re_branch='^[a-z0-9][a-z0-9._/-]{0,99}$'
re_ver='^[0-9]+\.[0-9]+$'

vurl() {
  [ $# -ge 1 ] || die "URL vacia"
  [ ${#1} -le 500 ] || die "URL demasiado larga"
  [[ "$1" =~ $re_url ]] || die "URL de repositorio no valida (solo https://.../user/repo)"
}
vbranch() { [ $# -ge 1 ] || die "rama invalida"; [[ "$1" =~ $re_branch ]] || die "rama invalida"; }
vver()    { [ $# -ge 1 ] || die "version PHP invalida"; [ -z "$1" ] && return 0; [[ "$1" =~ $re_ver ]] || die "version PHP invalida"; }
# Token para repos privados (GitHub PAT / tokens HTTP): juego seguro, sin
# espacios ni caracteres que rompan el credential-helper temporal.
re_token='^[A-Za-z0-9._:-]{8,500}$'
vtok()    { [ $# -ge 1 ] || die "token invalido"; [ -z "$1" ] && return 0; [[ "$1" =~ $re_token ]] || die "token invalido"; }

fs_full() { echo "/home/$1/$2"; }

# fs_check <usuario> <ruta-relativa>: garantiza que la ruta no atraviesa enlaces
# simbolicos de /home/<u> hacia fuera (aislamiento entre usuarios). Recorre los
# segmentos ya existentes; si alguno es symlink se aborta.
fs_check() { # $1=usuario $2=ruta-relativa
  local u="$1" r="$2" dir="/home/$u" IFS=/ segs=() s
  if [ -L "$dir" ]; then die "el home del usuario es un enlace simbolico"; fi
  [ -n "$r" ] || return 0
  read -ra segs <<< "$r" || true
  for s in "${segs[@]}"; do
    [ -n "$s" ] || continue
    dir="$dir/$s"
    if [ -L "$dir" ]; then die "la ruta atraviesa un enlace simbolico ('$s'): operacion no permitida"; fi
  done
}

# Chown por uid/gid del usuario (evita "invalid user" si falta la cuenta Linux)
fchown() { # $1+=rutas
  local u="$1"; shift
  local uid gid
  uid="$(id -u "$u" 2>/dev/null)" || die "usuario $u no existe en el sistema"
  gid="$(id -g "$u" 2>/dev/null)" || die "grupo $u no existe"
  chown "$uid:$gid" "$@"
}

# Asegura la cuenta Unix del usuario del panel (idempotente). Si no existe se
# crea sin clave (bloqueada) y con su home; la clave real se fija luego con
# user:setpw (Ajustes -> Mi contrasena). Sin esto, un panelista cuya cuenta se
# perdio no puede usar Archivos/Dominios ("el usuario X no existe").
ensure_linux_user() { # $1=usuario
  local u="$1"
  vuser "$u"
  if ! id "$u" >/dev/null 2>&1; then
    if getent group "$u" >/dev/null 2>&1; then
      useradd -m -s /bin/bash -g "$u" "$u"
    else
      useradd -m -s /bin/bash "$u"
    fi
    passwd -l "$u" >/dev/null 2>&1 || true
    echo "ATENCION: la cuenta Linux '$u' no existia y se ha creado; asigna su clave en panel -> Ajustes -> Mi contrasena." >&2
  fi
  install -d -o "$u" -g "$u" "/home/$u"
}

# Asegura la cuenta MySQL 'usuario'@'localhost' y 'usuario'@'%' (idempotente).
# Si no existe se crea con una clave temporal (hex) y los permisos de siempre:
# opcionalmente TODAS las bases (admin) o solo las propias <u>_%. La clave real
# la fija el panel al cambiar la contrasena de la cuenta (user:setpw).
ensure_mysql_user() { # $1=usuario [$2=admin]
  local u="$1" is_adm="${2:-}" tmp have_l=0 have_r=0
  vuser "$u"
  msql -N -B -e "SELECT COUNT(*) FROM mysql.user WHERE User='$u' AND Host='localhost'" | grep -qx '1' && have_l=1 || true
  msql -N -B -e "SELECT COUNT(*) FROM mysql.user WHERE User='$u' AND Host='%'" | grep -qx '1' && have_r=1 || true
  if [ "$have_l" = 1 ] && [ "$have_r" = 1 ]; then
    return 0
  fi
  tmp="$(openssl rand -hex 16)"; tmp="${tmp:0:16}"
  if [ "$have_l" = 0 ]; then
    msql -e "CREATE USER IF NOT EXISTS '$u'@'localhost' IDENTIFIED BY '$tmp'"
    echo "ATENCION: la cuenta MySQL '$u'@'localhost' no existia y se ha creado con clave temporal." >&2
  fi
  if [ "$have_r" = 0 ]; then
    msql -e "CREATE USER IF NOT EXISTS '$u'@'%' IDENTIFIED BY '$tmp'"
    echo "ATENCION: la cuenta MySQL '$u'@'%' no existia y se ha creado con clave temporal." >&2
  fi
  if [ "$is_adm" = "admin" ]; then
    msql -e "GRANT ALL PRIVILEGES ON *.* TO '$u'@'localhost', '$u'@'%' WITH GRANT OPTION"
  else
    esc=$(printf '%s' "$u" | sed 's/[_%]/\\&/g')
    msql -e "GRANT ALL PRIVILEGES ON \`${esc}\_%\`.* TO '$u'@'localhost', '$u'@'%'"
  fi
  msql -e "FLUSH PRIVILEGES"
}

apache_reload() {
  local out
  if ! out="$(apache2ctl -t 2>&1)"; then
    echo "error: configuracion apache invalida" >&2
    printf '%s\n' "$out" | sed 's/^/  /' >&2
    exit 2
  fi
  systemctl reload apache2 >/dev/null 2>&1 || apache2ctl graceful >/dev/null 2>&1 || true
}

# Un "certbot --apache" fallido (p.ej. DNS aún sin apuntar al servidor) puede dejar
# un vhost SSL residual (<d>-le-ssl.conf) que referencia un certificado inexistente
# y rompe apache2ctl -t para TODOS los dominios. Esta función elimina SOLO ese
# vhost residual (el que referencia un live/ que ya no tiene fullchain.pem); un
# vhost SSL válido se conserva.
prune_ssl_vhost() { # $1=dominio
  local d="$1" base sc
  for sc in "/etc/apache2/sites-available/${d}-le-ssl.conf" "/etc/apache2/sites-available/${d}-ssl.conf"; do
    [ -f "$sc" ] || continue
    base="$(basename "$sc")"
    if grep -q "/etc/letsencrypt/live/$d/" "$sc" 2>/dev/null && [ ! -f "/etc/letsencrypt/live/$d/fullchain.pem" ]; then
      a2dissite "$base" >/dev/null 2>&1 || true
      rm -f -- "$sc" "/etc/apache2/sites-enabled/$base"
      log "vhost SSL residual de $d eliminado ($base)"
    fi
  done
}

vhost_conf() { # $1=usuario $2=dominio $3=folder $4=document_root $5=php_version
  local u="$1" d="$2" f="$3" dr="${4:-}" pv="${5:-}" fpm= fpm_opt=
  [ -n "$dr" ] || dr="$f"
  # PHP por versión: solo aplica si hay pooling FPM de esa versión. Con mod_php
  # global (instalación por defecto) la versión es la del sistema y el vhost no
  # se toca; si se pide otra versión sin su socket, se mantiene mod_php (el sitio
  # igual se sirve correctamente con el PHP del sistema).
  if [ -n "$pv" ] && [ -S "/run/php/php${pv}-fpm.sock" ]; then
    fpm="$pv"
    fpm_opt=$(printf '\n    <IfModule mod_proxy_fcgi.c>\n      <FilesMatch "\\.php$">\n        SetHandler "proxy:unix:/run/php/php%s-fpm.sock|fcgi://localhost/home/%s/%s"\n      </FilesMatch>\n    </IfModule>' "$fpm" "$u" "$dr")
  fi
  printf '<VirtualHost *:80>\n  ServerAdmin webmaster@%s\n  ServerName %s\n  ServerAlias www.%s\n  DocumentRoot "/home/%s/%s"\n  <Directory "/home/%s/%s">\n    Options -Indexes +FollowSymLinks\n    AllowOverride All\n    Require all granted\n%s\n  </Directory>\n  <IfModule mod_ruid2.c>\n    RMode config\n    RUidGid %s %s\n  </IfModule>\n  ErrorLog ${APACHE_LOG_DIR}/%s-error.log\n  CustomLog ${APACHE_LOG_DIR}/%s-access.log combined\n</VirtualHost>\n' \
    "$d" "$d" "$d" "$u" "$dr" "$u" "$dr" "$fpm_opt" "$u" "$u" "$u" "$u" \
    > "/etc/apache2/sites-available/$d.conf"
  chmod 644 "/etc/apache2/sites-available/$d.conf"
  ln -sf "/etc/apache2/sites-available/$d.conf" "/etc/apache2/sites-enabled/$d.conf"
}

# ¿El vhost $1 es el del panel (DocumentRoot=/home/miserver/panel)?
is_panel_vhost() {
  [ -f "/etc/apache2/sites-available/$1.conf" ] \
    && grep -q '/home/miserver/panel' "/etc/apache2/sites-available/$1.conf"
}

# Garantiza un vhost para $d apuntando a la carpeta pedida. Solo se respeta el
# vhost del panel; cualquier otra conf (aunque exista de antes) se reescribe para
# que nunca sirva la carpeta equivocada de otro dominio.
vhost_ensure() { # $1=usuario $2=dominio $3=folder [$4=document_root] [$5=php_version]
  local u="$1" d="$2" f="$3" dr="${4:-}" pv="${5:-}"
  vuser "$u"; vdom "$d"; vrel "$f"
  if [ -n "$dr" ]; then vrel "$dr"; fi
  vver "$pv"
  if is_panel_vhost "$d"; then
    echo "vhost del panel, se respeta"
    return
  fi
  vhost_conf "$u" "$d" "$f" "$dr" "$pv"
}

# MySQL por socket (el wrapper corre como root durante la instalación)
msql() { mysql --protocol=socket "$@"; }

# Copia .env.example -> .env cuando el proyecto recién clonado no tiene .env.
# Para Laravel genera APP_KEY si está vacío/ausente, evitando despliegues rotos.
deploy_ensure_env() { # $1=usuario $2=carpeta-proyecto [$3=phpbin]
  local u="$1" target="$2" phpbin="${3:-/usr/bin/php}"
  local envfile="$target/.env" src=""
  [ -f "$envfile" ] && return 0
  for cand in "$target/.env.example" "$target/.env.local" "$target/.env.dist"; do
    [ -f "$cand" ] && { src="$cand"; break; }
  done
  [ -n "$src" ] || return 0
  cp -a -- "$src" "$envfile"
  sed -i 's/\r$//' "$envfile" 2>/dev/null || true
  chown "$u:$u" "$envfile"
  chmod 644 "$envfile" 2>/dev/null || true
  log "env creado desde $(basename "$src") para $u:$target"
    if [ -f "$target/artisan" ]; then
    if grep -qE '^APP_KEY=[[:space:]]*$' "$envfile" 2>/dev/null || ! grep -qE '^APP_KEY=' "$envfile" 2>/dev/null; then
      runuser -u "$u" -- env -C "$target" HOME="/home/$u" COMPOSER_HOME="/home/$u/.composer" "$phpbin" artisan key:generate --force --no-interaction >/dev/null 2>&1 || true
    fi
  fi
}

# Cuerpo de app:deploy; se reusa en app:pull.
do_app_deploy() {
  local u="$1" rel="$2" pv="${3:-}" steps="${4:-all}" npm_script
  vuser "$u"; vrel "$rel"; vver "$pv"
  case "$steps" in all|composer|npm|cache|migrate) ;; *) die "pasos invalidos: $steps" ;; esac
  ensure_linux_user "$u"
  fs_check "$u" "$rel"
  local target="/home/$u/$rel"
  [ -d "$target" ] || die "no existe la carpeta '$rel'"
  local phpbin=/usr/bin/php
  if [ -n "$pv" ] && [ -x "/usr/bin/php${pv}" ]; then
    phpbin="/usr/bin/php${pv}"
  fi
  echo "[deploy] usuario=$u php=$phpbin pasos=$steps"
  echo "[deploy] proyecto=/home/$u/$rel"
  deploy_ensure_env "$u" "$target" "$phpbin"
  if [ "$steps" = all ] || [ "$steps" = composer ]; then
    if [ -f "$target/composer.json" ]; then
      local carr=() phar=0
      if [ -x /usr/local/bin/composer ]; then carr=(/usr/local/bin/composer)
      elif command -v composer >/dev/null 2>&1; then carr=("$(command -v composer)")
      elif [ -f "$target/composer.phar" ]; then carr=("$phpbin" "$target/composer.phar"); phar=1
      fi
      if [ "${#carr[@]}" -eq 0 ]; then
        echo "[deploy] Composer no detectado; instalando /usr/local/bin/composer..."
        if ! curl -fsSL https://getcomposer.org/installer | "$phpbin" -- --install-dir=/usr/local/bin --filename=composer 2>&1; then
          echo "error: no se pudo instalar Composer" >&2
          exit 1
        fi
        carr=(/usr/local/bin/composer)
      fi
      echo "[deploy] composer install --no-dev --optimize-autoloader ..."
      if ! timeout 900 runuser -u "$u" -- env -C "$target" HOME="/home/$u" COMPOSER_HOME="/home/$u/.composer" "${carr[@]}" install --no-interaction --prefer-dist --no-dev --optimize-autoloader 2>&1; then
        echo "error: 'composer install' falló" >&2
        exit 1
      fi
    else
      echo "[deploy] sin composer.json, se omite composer"
    fi
  fi
  if [ "$steps" = all ] || [ "$steps" = npm ]; then
    if [ -f "$target/package.json" ]; then
      if ! command -v npm >/dev/null 2>&1; then
        echo "error: npm no esta instalado en el servidor (instala nodejs)" >&2
        exit 1
      fi
      echo "[deploy] npm install ..."
      # npm ci es mas rapido/reproducible cuando hay package-lock.json.
      if [ -f "$target/package-lock.json" ]; then
        if ! timeout 900 runuser -u "$u" -- env -C "$target" HOME="/home/$u" npm ci 2>&1; then
          echo "[deploy] npm ci fallo, reintentando con npm install ..."
          if ! timeout 900 runuser -u "$u" -- env -C "$target" HOME="/home/$u" npm install 2>&1; then
            echo "error: 'npm install' fallo" >&2
            exit 1
          fi
        fi
      else
        if ! timeout 900 runuser -u "$u" -- env -C "$target" HOME="/home/$u" npm install 2>&1; then
          echo "error: 'npm install' fallo" >&2
          exit 1
        fi
      fi
      # Elige el script de build mas comun: build > prod > production.
      npm_script="build"
      if grep -qE '"build"\s*:' "$target/package.json" 2>/dev/null; then
        npm_script="build"
      elif grep -qE '"prod"\s*:' "$target/package.json" 2>/dev/null; then
        npm_script="prod"
      elif grep -qE '"production"\s*:' "$target/package.json" 2>/dev/null; then
        npm_script="production"
      fi
      echo "[deploy] npm run $npm_script ..."
      if ! timeout 900 runuser -u "$u" -- env -C "$target" HOME="/home/$u" npm run "$npm_script" 2>&1; then
        echo "error: 'npm run $npm_script' fallo" >&2
        exit 1
      fi
    else
      echo "[deploy] sin package.json, se omite npm"
    fi
  fi
  if [ "$steps" = all ] || [ "$steps" = cache ]; then
    if [ -f "$target/artisan" ]; then
      echo "[deploy] artisan config:cache ..."
      timeout 300 runuser -u "$u" -- env -C "$target" HOME="/home/$u" COMPOSER_HOME="/home/$u/.composer" "$phpbin" artisan config:cache 2>&1 || { echo "error: 'config:cache' falló" >&2; exit 1; }
      echo "[deploy] artisan route:cache ..."
      timeout 300 runuser -u "$u" -- env -C "$target" HOME="/home/$u" COMPOSER_HOME="/home/$u/.composer" "$phpbin" artisan route:cache 2>&1 || { echo "error: 'route:cache' falló" >&2; exit 1; }
      echo "[deploy] artisan view:cache ..."
      timeout 300 runuser -u "$u" -- env -C "$target" HOME="/home/$u" COMPOSER_HOME="/home/$u/.composer" "$phpbin" artisan view:cache 2>&1 || { echo "error: 'view:cache' falló" >&2; exit 1; }
    else
      echo "[deploy] sin artisan, se omiten caches de Laravel (CodeIgniter usa spark, carece de config:cache)"
    fi
  fi
  if [ "$steps" = migrate ]; then
    if [ -f "$target/artisan" ]; then
      echo "[deploy] artisan migrate --force ..."
      timeout 600 runuser -u "$u" -- env -C "$target" HOME="/home/$u" COMPOSER_HOME="/home/$u/.composer" "$phpbin" artisan migrate --force 2>&1 || { echo "error: 'migrate' falló" >&2; exit 1; }
    elif [ -f "$target/spark" ]; then
      echo "[deploy] spark migrate (CodeIgniter 4) ..."
      timeout 600 runuser -u "$u" -- env -C "$target" HOME="/home/$u" COMPOSER_HOME="/home/$u/.composer" "$phpbin" spark migrate 2>&1 || { echo "error: 'spark migrate' falló" >&2; exit 1; }
    else
      echo "[deploy] sin artisan/spark, no hay migraciones que aplicar"
    fi
  fi
  echo ok
}

# -----------------------------------------------------------------------------
# Comandos
# -----------------------------------------------------------------------------
case "$cmd" in
  ping)
    echo ok
    ;;

  check:pass)
    [ $# -ge 1 ] || die "check:pass <pass>"
    vpass "$1" && echo ok
    ;;

  # --- Cuentas ---------------------------------------------------------------
  user:add)
    [ $# -ge 3 ] || die "user:add <usuario> <pass> <dominio> [admin]"
    u="$1"; p="$2"; d="$3"
    is_admin=0
    adm=''
    [ $# -ge 4 ] && [ "$4" = "admin" ] && { is_admin=1; adm='admin'; }
    vuser "$u"; vpass "$p"; vdom "$d"
    log "user:add $u $d${is_admin:+ [admin]}"
    # Auto-repara la cuenta si falta (p.ej. un init que dejó solo la BD).
    ensure_linux_user "$u"
    setpw_linux "$u" "$p"
    mkdir -p "/home/$u/public_html"
    if [ -z "$(ls -A "/home/$u/public_html" 2>/dev/null)" ]; then
      printf '<h1>Bienvenido a %s</h1>\n' "$d" > "/home/$u/public_html/index.html"
    fi
    chown -R "$u:$u" "/home/$u"
    vhost_ensure "$u" "$d" "public_html"
    # Cuenta MySQL: localhost + remoto (%). Admin ve TODAS las BD; el resto
    # solo las suyas con prefijo "$u"_ (GRANT por patrón, cubre las futuras).
    ensure_mysql_user "$u" "$adm"
    msql -e "ALTER USER '$u'@'localhost' IDENTIFIED BY '$p'; ALTER USER '$u'@'%' IDENTIFIED BY '$p'; FLUSH PRIVILEGES;" 2>/dev/null || true
    apache_reload || echo "ATENCION: recargar apache fallo (apache2ctl -t); la cuenta si se creo" >&2
    echo ok
    ;;

  user:setpw)
    [ $# -ge 2 ] || die "user:setpw <usuario> <pass> [admin]"
    u="$1"; p="$2"; vuser "$u"; vpass "$p"
    log "user:setpw $u"
    ensure_linux_user "$u"
    setpw_linux "$u" "$p"
    ensure_mysql_user "$u" "${3:-}"
    msql -e "ALTER USER '$u'@'localhost' IDENTIFIED BY '$p'; ALTER USER '$u'@'%' IDENTIFIED BY '$p'; FLUSH PRIVILEGES;" 2>/dev/null || true
    echo ok
    ;;

  # Sincroniza SOLO la clave MySQL con la del panel (autocura si la cuenta se
  # creo con clave temporal o quedo desincronizada). No toca la cuenta Linux.
  user:syncpw)
    [ $# -ge 2 ] || die "user:syncpw <usuario> <pass> [admin]"
    u="$1"; p="$2"; vuser "$u"; vpass "$p"
    log "user:syncpw $u"
    ensure_mysql_user "$u" "${3:-}"
    if ! msql -e "ALTER USER '$u'@'localhost' IDENTIFIED BY '$p'; ALTER USER '$u'@'%' IDENTIFIED BY '$p'; FLUSH PRIVILEGES;" 2>/dev/null; then
      echo "ATENCION: no se pudo sincronizar la clave MySQL de '$u' (¿mysql caido?)" >&2
      exit 1
    fi
    echo ok
    ;;

  user:home)
    [ $# -ge 1 ] || die "user:home <usuario>"
    u="$1"; vuser "$u"
    log "user:home $u"
    ensure_linux_user "$u"
    install -d -o "$u" -g "$u" "/home/$u/public_html"
    if [ -z "$(ls -A "/home/$u/public_html" 2>/dev/null)" ]; then
      printf '<h1>Bienvenido</h1>\n' > "/home/$u/public_html/index.html"
    fi
    chown -R "$u:$u" "/home/$u"
    echo ok
    ;;

  user:del)
    [ $# -ge 1 ] || die "user:del <usuario>"
    u="$1"; vuser "$u"
    [ "$u" != "miserver" ] || die "no se puede eliminar la cuenta del panel"
    log "user:del $u"
    for f in /etc/apache2/sites-available/*.conf; do
      [ -f "$f" ] || continue
      grep -q "RUidGid $u " "$f" 2>/dev/null || continue
      n="$(basename "$f")"
      a2dissite "$n" >/dev/null 2>&1 || true
      rm -f "$f" "/etc/apache2/sites-enabled/$n"
    done
    userdel -r "$u" 2>/dev/null || true
    msql -e "DROP USER IF EXISTS '$u'@'localhost'; DROP USER IF EXISTS '$u'@'%'; FLUSH PRIVILEGES;" 2>/dev/null || true
    apache_reload
    echo ok
    ;;

  # --- Vhosts / SSL ----------------------------------------------------------
  vhost:add)
    [ $# -ge 3 ] || die "vhost:add <usuario> <dominio> <folder> [document_root] [php_version]"
    u="$1"; d="$2"; f="$3"; dr="${4:-}"; pv="${5:-}"
    vuser "$u"; vdom "$d"; vrel "$f"
    if [ -n "$dr" ]; then vrel "$dr"; else dr="$f"; fi
    vver "$pv"
    log "vhost:add $u $d $f [docroot=$dr] [php=$pv]"
    ensure_linux_user "$u"
    base="/home/$u/$f"
    root="/home/$u/$dr"
    mkdir -p "$base"
    mkdir -p "$root"
    if [ -z "$(ls -A "$root" 2>/dev/null)" ]; then
      printf '<h1>%s</h1>\n' "$d" > "$root/index.html"
    fi
    chown -R "$u:$u" "$base"
    vhost_ensure "$u" "$d" "$f" "$dr" "$pv"
    prune_ssl_vhost "$d"
    apache_reload
    echo "DocumentRoot='/home/$u/$dr'"
    echo ok
    ;;

  vhost:del)
    [ $# -ge 1 ] || die "vhost:del <dominio>"
    d="$1"; vdom "$d"
    is_panel_vhost "$d" && die "es el vhost del panel, no se elimina"
    log "vhost:del $d"
    a2dissite "$d.conf" >/dev/null 2>&1 || true
    rm -f "/etc/apache2/sites-available/$d.conf" "/etc/apache2/sites-enabled/$d.conf"
    # También el vhost SSL (certbot --apache lo genera aparte).
    a2dissite "$d-le-ssl.conf" >/dev/null 2>&1 || true
    a2dissite "$d-ssl.conf" >/dev/null 2>&1 || true
    rm -f "/etc/apache2/sites-available/$d-le-ssl.conf" "/etc/apache2/sites-enabled/$d-le-ssl.conf" \
          "/etc/apache2/sites-available/$d-ssl.conf" "/etc/apache2/sites-enabled/$d-ssl.conf"
    if [ -d "/etc/letsencrypt/live/$d" ]; then
      certbot revoke --cert-path "/etc/letsencrypt/live/$d/fullchain.pem" --delete-after-revoke >/dev/null 2>&1 || true
    fi
    prune_ssl_vhost "$d"
    apache_reload
    echo ok
    ;;

  vhost:toggle)
    [ $# -ge 2 ] || die "vhost:toggle <dominio> on|off"
    d="$1"; s="$2"; vdom "$d"
    [ "$s" = on ] || [ "$s" = off ] || die "estado debe ser on|off"
    is_panel_vhost "$d" && die "el vhost del panel no se puede desactivar"
    log "vhost:toggle $d $s"
    if [ "$s" = on ]; then a2ensite "$d.conf" >/dev/null 2>&1 || true; else a2dissite "$d.conf" >/dev/null 2>&1 || true; fi
    prune_ssl_vhost "$d"
    apache_reload
    echo ok
    ;;

  vhost:check)
    [ $# -ge 1 ] || die "vhost:check <dominio>"
    d="$1"; vdom "$d"
    conf="/etc/apache2/sites-available/$d.conf"
    [ -f "$conf" ] || { echo "error: no hay vhost para $d" >&2; exit 2; }
    echo "== VirtualHost resuelto =="
    grep -E '^\s*(ServerName|ServerAlias|DocumentRoot|RUidGid)' "$conf"
    root="$(awk '/^[[:space:]]*DocumentRoot/{gsub(/"/,""); sub(/^[[:space:]]*DocumentRoot[[:space:]]+/,""); print; exit}' "$conf")"
    echo "== carpeta fisica =="
    if [ -d "$root" ]; then
      stat -c 'dir  %A  %U:%G  -> %n' "$root"
      du -sh "$root" 2>/dev/null | sed 's/^/tam  /'
    else
      echo "error: $root NO existe"
      exit 2
    fi
    if ! apache2ctl -t >/dev/null 2>&1; then
      echo "== apache configtest: ERROR =="
      apache2ctl -t
      exit 2
    fi
    echo "== apache2ctl -S (coincidencia de vhost) =="
    apache2ctl -S 2>&1 | grep -iE "$d|port 80 namevhost" | grep -v '^.*RUidGid' || true
    echo "== respuesta local con Host: $d =="
    if command -v curl >/dev/null 2>&1; then
      curl -m 6 -s -o /tmp/vhost-check.html -w 'HTTP %{http_code} desde %{url_effective}\n' -H "Host: $d" "http://127.0.0.1/" || echo "sin respuesta HTTP local"
      [ -f /tmp/vhost-check.html ] && { head -c 200 /tmp/vhost-check.html | sed 's/^/  /'; rm -f /tmp/vhost-check.html; }
    else
      echo "(curl no disponible; omite comprobacion HTTP)"
    fi
    echo ok
    ;;

  vhost:logs)
    [ $# -ge 1 ] || die "vhost:logs <dominio> [error|access] [lineas]"
    d="$1"; type="${2:-error}"; lines="${3:-200}"
    vdom "$d"
    [ "$type" = "error" ] || [ "$type" = "access" ] || die "tipo debe ser error o access"
    case "$lines" in ''|*[!0-9]*) lines=200 ;; esac
    [ "$lines" -le 10000 ] || lines=10000
    f="/var/log/apache2/${d}-${type}.log"
    [ -f "$f" ] || { echo "(sin log)"; exit 0; }
    tail -n "$lines" "$f"
    ;;

  cert:status)
    [ $# -ge 1 ] || die "cert:status <dominio>"
    d="$1"; vdom "$d"
    cert="/etc/letsencrypt/live/$d/fullchain.pem"
    if [ ! -f "$cert" ]; then
      echo "status|missing"
      exit 0
    fi
    exp="$(openssl x509 -in "$cert" -noout -enddate 2>/dev/null | cut -d= -f2 || true)"
    if [ -z "$exp" ]; then
      echo "status|invalid"
      exit 0
    fi
    exp_epoch="$(date -d "$exp" +%s 2>/dev/null || echo 0)"
    now_epoch="$(date +%s)"
    days=$(( (exp_epoch - now_epoch) / 86400 ))
    echo "status|ok|$exp|$days"
    ;;

  cert:issue)
    [ $# -ge 1 ] || die "cert:issue <dominio> [email]"
    d="$1"; vdom "$d"
    email="${2:-}"
    log "cert:issue $d"
    run_cert() {
      # timeout 450: seguro anti-cuelgue por intento (certbot no puede quedarse
      # colgado esperando respuesta de DNS/puerto 80 para siempre).
      if [ -n "$email" ]; then
        timeout 450 certbot --apache --non-interactive --agree-tos --redirect -m "$email" -d "$d"
      else
        timeout 450 certbot --apache --non-interactive --agree-tos --redirect --register-unsafely-without-email -d "$d"
      fi
    }
    # Reintenta hasta ~4 min: el DNS del dominio recién creado puede tardar en
    # propagar. Cada intento escribe progreso -> visible en "Tareas".
    MAX_INTENTOS=12
    i=0
    while [ "$i" -lt "$MAX_INTENTOS" ]; do
      i=$((i + 1))
      ip="$(getent hosts "$d" | awk '{print $1}' | head -1 || true)"
      echo "[cert] $d intento $i/$MAX_INTENTOS (DNS=$ip)"
      if [ -n "$ip" ] && run_cert; then
        apache_reload
        echo ok
        exit 0
      fi
      [ "$i" -lt "$MAX_INTENTOS" ] && sleep 20
    done
    # Limpia el vhost SSL residual que pudo dejar certbot en los intentos fallidos
    # (si no, apache2ctl -t falla para todos los dominios) y deja Apache validando.
    prune_ssl_vhost "$d"
    apache_reload 2>/dev/null || true
    echo "error: no se pudo emitir el certificado para $d (¿DNS apunta a este servidor y el puerto 80 está abierto?)" >&2
    exit 1
    ;;

  # --- Bases de datos --------------------------------------------------------
  db:add)    [ $# -ge 1 ] || die "db:add <nombre> [usuario-dueño] [admin]"; vname "$1"; log "db:add $1"
             msql -e "CREATE DATABASE IF NOT EXISTS \`$1\` CHARACTER SET utf8mb4"
             if [ $# -ge 2 ]; then vuser "$2"
               ensure_mysql_user "$2" "${3:-}"
               msql -e "GRANT ALL PRIVILEGES ON \`$1\`.* TO '$2'@'localhost', '$2'@'%'; FLUSH PRIVILEGES;"
             fi
             echo ok ;;
  db:del)    [ $# -ge 1 ] || die "db:del <nombre>"; vname "$1"; log "db:del $1"
             msql -e "DROP DATABASE IF EXISTS \`$1\`"; echo ok ;;

  dbu:add)   [ $# -ge 2 ] || die "dbu:add <usuario> <pass>"; vname "$1"; vpass "$2"; log "dbu:add $1"
             msql -e "CREATE USER IF NOT EXISTS \`$1\`@'localhost' IDENTIFIED BY '$2'; CREATE USER IF NOT EXISTS \`$1\`@'%' IDENTIFIED BY '$2'; FLUSH PRIVILEGES;"
             echo ok ;;
  dbu:setpw) [ $# -ge 2 ] || die "dbu:setpw <usuario> <pass>"; vname "$1"; vpass "$2"; log "dbu:setpw $1"
             msql -e "ALTER USER \`$1\`@'localhost' IDENTIFIED BY '$2'; ALTER USER \`$1\`@'%' IDENTIFIED BY '$2'; FLUSH PRIVILEGES;"
             echo ok ;;
  dbu:del)   [ $# -ge 1 ] || die "dbu:del <usuario>"; vname "$1"; log "dbu:del $1"
             msql -e "DROP USER IF EXISTS \`$1\`@'localhost', \`$1\`@'%'; FLUSH PRIVILEGES;"
             echo ok ;;

  db:grant)  [ $# -ge 2 ] || die "db:grant <base> <usuario>"; vname "$1"; vname "$2"; log "db:grant $2 -> $1"
             msql -e "GRANT ALL PRIVILEGES ON \`$1\`.* TO \`$2\`@'localhost', \`$2\`@'%'; FLUSH PRIVILEGES;"
             echo ok ;;
  db:revoke) [ $# -ge 2 ] || die "db:revoke <base> <usuario>"; vname "$1"; vname "$2"; log "db:revoke $2 -> $1"
             msql -e "REVOKE ALL PRIVILEGES ON \`$1\`.* FROM \`$2\`@'localhost', \`$2\`@'%'; FLUSH PRIVILEGES;" 2>/dev/null || true
             echo ok ;;

  db:grants)
    [ $# -ge 1 ] || die "db:grants <usuario>"
    vname "$1"
    for h in localhost '%'; do
      echo "== '$1'@'$h' =="
      msql -e "SHOW GRANTS FOR '$1'@'$h'" 2>/dev/null || echo "  (no existe la cuenta para el host $h)"
    done
    echo "== bases reales que puede ver =="
    msql -N -e "SHOW DATABASES LIKE '${1}\\\_%'" 2>/dev/null || true
    echo ok
    ;;

  db:admin)  [ $# -ge 1 ] || die "db:admin <usuario>"; vuser "$1"; log "db:admin $1 (todas las BD)"
             ensure_mysql_user "$1" "admin"
             msql -e "GRANT ALL PRIVILEGES ON *.* TO \`$1\`@'localhost', \`$1\`@'%' WITH GRANT OPTION; FLUSH PRIVILEGES;"
             echo ok ;;
  db:unadmin) [ $# -ge 1 ] || die "db:unadmin <usuario>"; vuser "$1"; log "db:unadmin $1"
             msql -e "REVOKE ALL PRIVILEGES ON *.* FROM \`$1\`@'localhost', \`$1\`@'%'; FLUSH PRIVILEGES;" 2>/dev/null || true
             echo ok ;;

  db:own)    [ $# -ge 1 ] || die "db:own <usuario>"; vuser "$1"; log "db:own $1 (solo sus BD)"
             ensure_mysql_user "$1"
             esc=$(printf '%s' "$1" | sed 's/[_%]/\\&/g')
             msql -e "GRANT ALL PRIVILEGES ON \`${esc}\_%\`.* TO \`$1\`@'localhost', \`$1\`@'%'; FLUSH PRIVILEGES;"
             echo ok ;;
  db:unown)  [ $# -ge 1 ] || die "db:unown <usuario>"; vuser "$1"; log "db:unown $1"
             esc=$(printf '%s' "$1" | sed 's/[_%]/\\&/g')
             msql -e "REVOKE ALL PRIVILEGES ON \`${esc}\_%\`.* FROM \`$1\`@'localhost', \`$1\`@'%'; FLUSH PRIVILEGES;" 2>/dev/null || true
             echo ok ;;

  # --- Cron ------------------------------------------------------------------
  cron:show)
    [ $# -ge 1 ] || die "cron:show <usuario>"
    vuser "$1"
    crontab -u "$1" -l 2>/dev/null || true
    ;;

  cron:set)
    [ $# -ge 1 ] || die "cron:set <usuario>"
    vuser "$1"; log "cron:set $1"
    tmp="$(mktemp)"
    trap 'rm -f "$tmp"' EXIT
    cat > "$tmp"
    chmod 600 "$tmp"
    crontab -u "$1" "$tmp"
    echo ok
    ;;

  # --- Archivos --------------------------------------------------------------
  fs:list)
    [ $# -ge 2 ] || die "fs:list <usuario> <ruta-relativa> [hidden]"
    u="$1"; r="$2"; vuser "$u"
    ensure_linux_user "$u"
    if [ -n "$r" ]; then vrel "$r"; fi   # ruta "" = raiz del home
    fs_check "$u" "$r"
    show_hidden=0
    [ $# -ge 3 ] && [ "$3" = "hidden" ] && show_hidden=1
    dir="$(fs_full "$u" "$r")"
    [ -d "$dir" ] || die "directorio no existe"
    for e in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
      if [ -e "$e" ]; then
        name="${e##*/}"
        if [ ! -L "$e" ]; then   # symlinks omitidos (aislamiento entre homes)
          if [ "$show_hidden" = 0 ] && [[ "$name" == .* ]]; then continue; fi
          if [ -d "$e" ]; then printf 'D\t%s\t%s\n' "$name" "$(stat -c %Y "$e")"
          else printf 'F\t%s\t%s\t%s\n' "$name" "$(stat -c %s "$e")" "$(stat -c %Y "$e")"; fi
        fi
      fi
    done
    ;;

  fs:cat)
    [ $# -ge 2 ] || die "fs:cat <usuario> <ruta-relativa> [maxbytes]"
    u="$1"; r="$2"; vuser "$u"; vrel "$r"; fs_check "$u" "$r"
    ensure_linux_user "$u"
    maxb="${3:-2097152}"
    full="$(fs_full "$u" "$r")"
    [ -f "$full" ] || die "no es un archivo"
    sz="$(stat -c %s "$full")"
    [ "$sz" -le "$maxb" ] || die "archivo demasiado grande ($sz bytes)"
    cat "$full"
    ;;

  fs:exists)
    [ $# -ge 2 ] || die "fs:exists <usuario> <ruta-relativa>"
    u="$1"; r="$2"; vuser "$u"; vrel "$r"; fs_check "$u" "$r"
    ensure_linux_user "$u"
    full="$(fs_full "$u" "$r")"
    [ -f "$full" ] || exit 1
    echo ok
    ;;

  fs:write)
    [ $# -ge 2 ] || die "fs:write <usuario> <ruta-relativa>"
    u="$1"; r="$2"; vuser "$u"; vrel "$r"; fs_check "$u" "$r"
    ensure_linux_user "$u"
    full="$(fs_full "$u" "$r")"
    mkdir -p "$(dirname "$full")"
    cat > "$full"          # contenido por stdin
    fchown "$u" "$full"
    chmod 644 "$full"
    echo ok
    ;;

  fs:put)
    [ $# -ge 3 ] || die "fs:put <usuario> <ruta-relativa> <archivo-temporal>"
    u="$1"; r="$2"; src="$3"; vuser "$u"; vrel "$r"; fs_check "$u" "$r"
    ensure_linux_user "$u"
    [ -f "$src" ] || die "archivo temporal no existe"
    full="$(fs_full "$u" "$r")"
    mkdir -p "$(dirname "$full")"
    mv "$src" "$full"
    fchown "$u" "$full"
    chmod 644 "$full"
    echo ok
    ;;

  fs:mkdir)
    [ $# -ge 2 ] || die "fs:mkdir <usuario> <ruta-relativa>"
    u="$1"; r="$2"; vuser "$u"; vrel "$r"; fs_check "$u" "$r"
    ensure_linux_user "$u"
    mkdir -p "$(fs_full "$u" "$r")"
    fchown "$u" "$(fs_full "$u" "$r")"
    echo ok
    ;;

  fs:mv)
    [ $# -ge 3 ] || die "fs:mv <usuario> <origen-rel> <destino-rel>"
    u="$1"; s="$2"; d="$3"; vuser "$u"; vrel "$s"; vrel "$d"; fs_check "$u" "$s"; fs_check "$u" "$d"
    ensure_linux_user "$u"
    src="$(fs_full "$u" "$s")"; dst="$(fs_full "$u" "$d")"
    [ -e "$src" ] || die "no existe"
    mkdir -p "$(dirname "$dst")"
    mv "$src" "$dst"
    [ -d "$dst" ] || chmod 644 "$dst"
    fchown "$u" "$dst"
    echo ok
    ;;

  fs:rm)
    [ $# -ge 2 ] || die "fs:rm <usuario> <ruta-relativa>"
    u="$1"; r="$2"; vuser "$u"; vrel "$r"; fs_check "$u" "$r"
    ensure_linux_user "$u"
    full="$(fs_full "$u" "$r")"
    [ -e "$full" ] || die "no existe"
    if [ -d "$full" ]; then
      rmdir "$full" 2>/dev/null || die "directorio no vacio (borra antes su contenido)"
    else
      rm -f "$full"
    fi
    echo ok
    ;;

  fs:rmtree)
    # Borrado recursivo de una CARPETA del home (usado como rollback de un clon
    # fallido). Nunca se borra el home ni public_html (donde puede haber otro sitio).
    [ $# -ge 2 ] || die "fs:rmtree <usuario> <carpeta-rel>"
    u="$1"; r="$2"; vuser "$u"; vrel "$r"; fs_check "$u" "$r"
    ensure_linux_user "$u"
    full="$(fs_full "$u" "$r")"
    [ -e "$full" ] || die "no existe"
    [ -d "$full" ] || die "solo carpetas"
    case "$r" in
      ""|"."|"public_html"|public_html/*) die "no puedes borrar esa carpeta" ;;
    esac
    rm -rf -- "$full"
    echo ok
    ;;

  fs:unzip)
    [ $# -ge 2 ] || die "fs:unzip <usuario> <ruta-zip-relativa>"
    u="$1"; r="$2"; vuser "$u"; vrel "$r"; fs_check "$u" "$r"
    ensure_linux_user "$u"
    full="$(fs_full "$u" "$r")"
    [ -f "$full" ] || die "no existe"
    case "$r" in *.zip|*.ZIP) ;; *) die "solo archivos .zip" ;; esac
    dir="$(dirname "$full")"
    if ! command -v unzip >/dev/null 2>&1; then
      die "unzip no esta instalado (apt install unzip)"
    fi
    runuser -u "$u" -- env -C "$dir" unzip -o -q -- "$full" >/dev/null 2>&1 || die "error al extraer el zip"
    echo ok
    ;;

  fs:chmod)
    [ $# -ge 3 ] || die "fs:chmod <usuario> <ruta> <modo-octal>"
    u="$1"; r="$2"; mode="$3"; vuser "$u"; vrel "$r"; fs_check "$u" "$r"
    ensure_linux_user "$u"
    case "$mode" in ''|*[!0-7]*) die "modo debe ser octal de 3 digitos (p.ej. 755)" ;; esac
    [ ${#mode} -eq 3 ] || die "modo debe ser octal de 3 digitos (p.ej. 755)"
    full="$(fs_full "$u" "$r")"
    [ -e "$full" ] || die "no existe"
    chmod "$mode" "$full"
    echo ok
    ;;

  fs:chown)
    [ $# -ge 2 ] || die "fs:chown <usuario> <ruta>"
    u="$1"; r="$2"; vuser "$u"; vrel "$r"; fs_check "$u" "$r"
    ensure_linux_user "$u"
    full="$(fs_full "$u" "$r")"
    [ -e "$full" ] || die "no existe"
    chown "$u:$u" "$full"
    echo ok
    ;;

  # --- Disco: uso por carpeta (dentro del home, sin seguir symlinks) -------
  du:users)
    # Homes de todos los usuarios con su tamaño total en bytes.
    for h in /home/*/; do
      [ -d "$h" ] || continue
      name="$(basename "$h")"
      [ "$name" = "miserver" ] && continue
      printf 'H\t%s\t%s\n' "$name" "$(du -sb "$h" 2>/dev/null | cut -f1 || echo 0)"
    done
    ;;

  du:stat)
    [ $# -eq 2 ] || die "du:stat <usuario> <ruta-relativa>"
    u="$1"; r="$2"; vuser "$u"
    ensure_linux_user "$u"
    if [ -n "$r" ]; then vrel "$r"; fi
    fs_check "$u" "$r"
    dir="$(fs_full "$u" "$r")"
    [ -d "$dir" ] || die "directorio no existe: $r"
    printf 'T\t%s\t%s\n' "${r:-.}" "$(du -sb "$dir" 2>/dev/null | cut -f1 || echo 0)"
    for e in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
      [ -e "$e" ] || continue
      name="${e##*/}"
      if [ -d "$e" ] && [ ! -L "$e" ]; then
        printf 'D\t%s\t%s\n' "$name" "$(du -sb "$e" 2>/dev/null | cut -f1 || echo 0)"
      elif [ -L "$e" ]; then
        printf 'L\t%s\t%s\n' "$name" "$(stat -c %s "$e" 2>/dev/null || echo 0)"
      else
        printf 'F\t%s\t%s\t%s\n' "$name" "$(stat -c %s "$e" 2>/dev/null || echo 0)" "$(stat -c %Y "$e" 2>/dev/null || echo 0)"
      fi
    done
    ;;

  sys:info)
    # Particiones: filesystem, 1K-blocks, used, available, use%, mountpoint
    df -Pk 2>/dev/null | tail -n +2 | awk '{print "part|"$1"|"$2"|"$3"|"$4"|"$5"|"$6}'
    free -m | awk '/Mem:/{print "mem|"$2"|"$3"|"$4}'
    awk '{print "load|"$1"|"$2"|"$3}' /proc/loadavg 2>/dev/null || true
    for h in /home/*/; do
      [ -d "$h" ] || continue
      name="$(basename "$h")"
      [ "$name" = "miserver" ] && continue
      size="$(du -sk "$h" 2>/dev/null | cut -f1 || echo 0)"
      printf 'home|%s|%s\n' "$name" "$size"
    done
    msql -N -B -e "SELECT table_schema, ROUND(SUM(data_length+index_length)/1024), COUNT(DISTINCT table_name) FROM information_schema.tables GROUP BY table_schema" 2>/dev/null | \
      while IFS=$'\t' read -r db size tbl; do printf 'db|%s|%s|%s\n' "$db" "${size:-0}" "${tbl:-0}"; done
    ;;

  backup:list)
    dir="/var/backups/miserver"
    [ -d "$dir" ] || { echo "file|0|-|sin-backups"; exit 0; }
    find "$dir" -maxdepth 1 -type f -printf "file|%s|%TY-%Tm-%Td %TH:%TM|%f\n" | sort -k4
    ;;

  backup:del)
    [ $# -ge 1 ] || die "backup:del <archivo>"
    dir="/var/backups/miserver"
    f="$1"
    case "$f" in
      *[!a-zA-Z0-9._-]*|*..*|"") die "nombre de archivo no valido" ;;
    esac
    full="$dir/$f"
    [ -f "$full" ] || die "archivo no encontrado"
    rm -f -- "$full"
    echo ok
    ;;

  # --- Backups manuales (un solo respaldo: homes + bases de datos) -----------
  backup:run)
    save_dir="${BACKUP_DIR:-/var/backups/miserver}"
    mkdir -p "$save_dir" 2>/dev/null || { echo "no se puede crear $save_dir"; exit 0; }
    chown root:miserver "$save_dir" 2>/dev/null || true
    chmod 0750 "$save_dir" 2>/dev/null || true
    ts="$(date +%Y%m%d-%H%M%S)"
    prefix="$save_dir/bk-${ts}"
    log "backup:run -> $prefix"
    rc_homes=0; rc_db=0
    # homes: archivos + carpetas de todos los usuarios (excepto el panel)
    tar --acls --numeric-owner -czf "${prefix}-homes.tar.gz" -C /home --exclude=./miserver . >"$LOG_DIR/backup-homes.log" 2>&1 || rc_homes=$?
    # bases de datos de usuarios (excluye las internas de MySQL y la del panel)
    dbs=""
    while IFS= read -r db; do
      case "$db" in information_schema|performance_schema|mysql|sys|miserver) continue;; esac
      dbs="$dbs $db"
    done < <(msql --batch --skip-column-names -e 'SHOW DATABASES' 2>"$LOG_DIR/backup-db.log" || true)
    if [ -n "$dbs" ]; then
      mysqldump --protocol=socket --single-transaction --routines --triggers $dbs 2>"$LOG_DIR/backup-db.log" | gzip -9 > "${prefix}-db.sql.gz" || rc_db=$?
    fi
    chown root:miserver "${prefix}"* 2>/dev/null || true
    chmod 0640 "${prefix}"* 2>/dev/null || true
    echo "bk-${ts}"
    [ $rc_homes -eq 0 ] || echo "aviso: los homes se respaldaron con errores rc=$rc_homes (log: $LOG_DIR/backup-homes.log)"
    [ $rc_db -eq 0 ] || echo "aviso: la copia de bases de datos fallo rc=$rc_db (log: $LOG_DIR/backup-db.log)"
    ls -1 "${prefix}"* 2>/dev/null | sed "s#^$save_dir/##" || true
    [ -e "${prefix}-homes.tar.gz" ] || [ -e "${prefix}-db.sql.gz" ] || die "el backup no genero archivos"
    exit 0
    ;;

  # --- Backup por carpeta (homes / cualquier subcarpeta) --------------------
  backup:folder)
    [ $# -eq 2 ] || die "backup:folder <usuario> <ruta-relativa>"
    u="$1"; r="$2"; vuser "$u"
    ensure_linux_user "$u"
    if [ -n "$r" ]; then vrel "$r"; fi
    fs_check "$u" "$r"
    dir="$(fs_full "$u" "$r")"
    [ -d "$dir" ] || die "directorio no existe: $r"
    save_dir="${BACKUP_DIR:-/var/backups/miserver}"
    mkdir -p "$save_dir" 2>/dev/null || { echo "no se puede crear $save_dir"; exit 0; }
    chown root:miserver "$save_dir" 2>/dev/null || true
    chmod 0750 "$save_dir" 2>/dev/null || true
    base="$(basename "$dir")"
    safe="$(printf '%s' "$base" | tr -c 'a-zA-Z0-9._-' '_')"
    [ -n "$safe" ] || safe="home"
    ts="$(date +%Y%m%d-%H%M%S)"
    out="$save_dir/bk-${u}-${safe}-${ts}.tar.gz"
    log "backup:folder $u '$r' -> $out"
    if ! tar --acls --numeric-owner -czf "$out" -C "$(dirname "$dir")" "$(basename "$dir")" >"$LOG_DIR/backup-folder.log" 2>&1; then
      echo "error: no se pudo crear el backup de la carpeta (log: $LOG_DIR/backup-folder.log)"
      exit 2
    fi
    size="$(stat -c %s "$out" 2>/dev/null || echo 0)"
    chown root:miserver "$out" 2>/dev/null || true
    chmod 0640 "$out" 2>/dev/null || true
    printf 'file|%s|%s|%s\n' "$size" "$(date '+%Y-%m-%d %H:%M')" "$(basename "$out")"
    ;;

  # --- Aplicaciones desde GitHub -------------------------------------------
  git:clone)
    [ $# -ge 3 ] || die "git:clone <usuario> <carpeta> <URL> [rama] [token]"
    u="$1"; f="$2"; url="$3"; br="${4:-}"; tok="${5:-}"
    vuser "$u"; vrel "$f"; vurl "$url"
    [ -n "$br" ] && vbranch "$br"
    [ -n "$tok" ] && vtok "$tok"
    # El token NUNCA se registra (la operación se loguea sin credenciales).
    log "git:clone $u $f $url${br:+ -b $br}"
    ensure_linux_user "$u"
    fs_check "$u" "$f"
    target="/home/$u/$f"
    had_target=0
    if [ -e "$target" ]; then
      had_target=1
      [ -z "$(ls -A "$target" 2>/dev/null)" ] || die "la carpeta destino ya contiene archivos: usa una carpeta nueva"
    fi
    mkdir -p "$(dirname "$target")"
    export GIT_TERMINAL_PROMPT=0
    helper=
    trap 'rm -f "$helper"' EXIT
    cleanup_clone() {
      # Borra un clon parcial dejado por git (solo si la carpeta NO existía antes
      # de este intento: no se tocan datos que hayan podido estar ahí).
      [ "$had_target" = 0 ] && [ -e "$target" ] && rm -rf -- "$target"
    }
    if [ -n "$tok" ]; then
      # Credential-helper temporal (ejecutable, permisos 700) con el token; se borra al salir.
      helper="$(mktemp)"
      printf '#!/bin/sh\necho username=x-access-token\necho password=%s\n' "$tok" > "$helper"
      chmod 700 "$helper"
    fi
    extra=(-c credential.helper=)
    if [ -n "$helper" ]; then
      extra=(-c credential.helper= -c credential.helper="$helper")
    fi
    if [ -n "$br" ]; then
      timeout 900 env GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git -c safe.directory="$target" "${extra[@]}" clone --depth 1 --branch "$br" --single-branch -- "$url" "$target" || { cleanup_clone; log "git:clone fallo $u $f"; exit 2; }
    else
      timeout 900 env GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git -c safe.directory="$target" "${extra[@]}" clone --depth 1 -- "$url" "$target" || { cleanup_clone; log "git:clone fallo $u $f"; exit 2; }
    fi
    # ownership para el usuario (ruid2 servirá como el dueño) y origen sin credenciales
    chown -R "$u:$u" "$target" 2>/dev/null || true
    env GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git -C "$target" -c safe.directory="$target" remote set-url origin "$url" 2>/dev/null || true
    # Configura pull.rebase para evitar "Need to specify how to reconcile" en Git >= 2.27
    env GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git -C "$target" -c safe.directory="$target" config pull.rebase true 2>/dev/null || true
    echo ok
    ;;

  git:pull)
    [ $# -ge 2 ] || die "git:pull <usuario> <carpeta> [rama] [token]"
    u="$1"; f="$2"; br="${3:-}"; tok="${4:-}"
    vuser "$u"; vrel "$f"
    [ -n "$br" ] && vbranch "$br"
    [ -n "$tok" ] && vtok "$tok"
    log "git:pull $u $f${br:+ $br}"
    ensure_linux_user "$u"
    target="/home/$u/$f"
    [ -d "$target/.git" ] || die "no es un repositorio git: $f"
    export GIT_TERMINAL_PROMPT=0
    helper=
    trap 'rm -f "$helper"' EXIT
    if [ -n "$tok" ]; then
      helper="$(mktemp)"
      printf '#!/bin/sh\necho username=x-access-token\necho password=%s\n' "$tok" > "$helper"
      chmod 700 "$helper"
    fi
    extra=(-c credential.helper=)
    if [ -n "$helper" ]; then
      extra=(-c credential.helper= -c credential.helper="$helper")
    fi
    if [ -n "$br" ]; then
      timeout 300 env GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git -C "$target" -c safe.directory="$target" "${extra[@]}" pull --rebase --depth 1 origin "$br" 2>&1 || { log "git:pull fallo $u $f"; die "git pull fallo"; }
    else
      timeout 300 env GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git -C "$target" -c safe.directory="$target" "${extra[@]}" pull --rebase --depth 1 2>&1 || { log "git:pull fallo $u $f"; die "git pull fallo"; }
    fi
    chown -R "$u:$u" "$target" 2>/dev/null || true
    echo ok
    ;;

  app:pull)
    [ $# -ge 2 ] || die "app:pull <usuario> <carpeta> [rama] [token] [php-version]"
    u="$1"; f="$2"; br="${3:-}"; tok="${4:-}"; pv="${5:-}"
    vuser "$u"; vrel "$f"
    [ -n "$br" ] && vbranch "$br"
    [ -n "$tok" ] && vtok "$tok"
    vver "$pv"
    ensure_linux_user "$u"
    target="/home/$u/$f"
    [ -d "$target/.git" ] || die "no es un repositorio git: $f"
    export GIT_TERMINAL_PROMPT=0
    helper=
    trap 'rm -f "$helper"' EXIT
    if [ -n "$tok" ]; then
      helper="$(mktemp)"
      printf '#!/bin/sh\necho username=x-access-token\necho password=%s\n' "$tok" > "$helper"
      chmod 700 "$helper"
    fi
    extra=(-c credential.helper=)
    if [ -n "$helper" ]; then
      extra=(-c credential.helper= -c credential.helper="$helper")
    fi
    if [ -n "$br" ]; then
      timeout 300 env GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git -C "$target" -c safe.directory="$target" "${extra[@]}" pull --rebase --depth 1 origin "$br" 2>&1 || { log "app:pull git fallo $u $f"; die "git pull fallo"; }
    else
      timeout 300 env GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git -C "$target" -c safe.directory="$target" "${extra[@]}" pull --rebase --depth 1 2>&1 || { log "app:pull git fallo $u $f"; die "git pull fallo"; }
    fi
    chown -R "$u:$u" "$target" 2>/dev/null || true
    do_app_deploy "$u" "$f" "$pv" "all"
    ;;

  git:detect)
    [ $# -ge 2 ] || die "git:detect <usuario> <carpeta>"
    u="$1"; r="$2"; vuser "$u"; vrel "$r"
    ensure_linux_user "$u"
    fs_check "$u" "$r"
    dir="/home/$u/$r"
    [ -d "$dir" ] || die "no existe la carpeta '$r'"
    type=other
    webroot='.'
    if [ -f "$dir/artisan" ] && [ -f "$dir/public/index.php" ]; then
      type=laravel; webroot=public
    elif [ -f "$dir/public/index.php" ] && [ ! -f "$dir/index.php" ]; then
      type=php; webroot=public
    elif [ -f "$dir/wp-config.php" ]; then
      type=wordpress; webroot='.'
    elif [ -f "$dir/index.php" ] || [ -f "$dir/index.html" ] || [ -f "$dir/index.htm" ]; then
      type=php; webroot='.'
    elif [ -f "$dir/package.json" ]; then
      type=node; webroot='.'
      # Vue: depende de @vue/cli, vite o del paquete vue en package.json.
      if [ -f "$dir/vue.config.js" ] || [ -f "$dir/vue.config.ts" ] || \
         [ -f "$dir/vite.config.js" ] || [ -f "$dir/vite.config.ts" ] || \
         grep -qE '"(@vue/cli-service|vue)"\s*:' "$dir/package.json" 2>/dev/null; then
        type=vue
      fi
    fi
    echo "type|$type"
    echo "webroot|$webroot"
    ;;

  # Despliegue post-clon (Laravel, CodeIgniter, Vue/Node y apps con composer).
  # Todo como el DUEÑO del proyecto (los archivos del vhost se sirven con
  # mod_ruid2 como ese usuario). La migración es SIEMPRE un paso aparte
  # (migrate): el despliegue normal (all = composer + npm + cache) NO migra
  # por defecto.
  #   app:deploy <usuario> <carpeta-proyecto> [php-version] [pasos]
  #   pasos: all (composer+npm+cache) | composer | npm | cache | migrate
  app:deploy)
    [ $# -ge 2 ] || die "app:deploy <usuario> <carpeta-proyecto> [php-version] [pasos]"
    do_app_deploy "$@"
    ;;

  security:ban)
    [ $# -ge 1 ] || die "security:ban <ip>"
    ip="$1"
    case "$ip" in
      *[!0-9.:]*) die "ip no valida" ;;
    esac
    if command -v ufw >/dev/null 2>&1; then
      ufw deny from "$ip" to any port 80,443 >/dev/null 2>&1 || true
      ufw deny from "$ip" to any port 22 >/dev/null 2>&1 || true
    elif command -v iptables >/dev/null 2>&1; then
      iptables -C INPUT -s "$ip" -j DROP >/dev/null 2>&1 || iptables -I INPUT 1 -s "$ip" -j DROP
    else
      die "no hay firewall disponible (ufw/iptables)"
    fi
    echo ok
    ;;

  security:unban)
    [ $# -ge 1 ] || die "security:unban <ip>"
    ip="$1"
    case "$ip" in *[!0-9.:]*) die "ip no valida" ;; esac
    if command -v ufw >/dev/null 2>&1; then
      ufw delete deny from "$ip" to any port 80,443 >/dev/null 2>&1 || true
      ufw delete deny from "$ip" to any port 22 >/dev/null 2>&1 || true
    elif command -v iptables >/dev/null 2>&1; then
      iptables -D INPUT -s "$ip" -j DROP >/dev/null 2>&1 || true
    fi
    echo ok
    ;;

  *)
    die "comando desconocido: $cmd"
    ;;
esac