# =====================================================================
# Mi Server - Panel de control (configuración)
# Copia este archivo a .env y edítalo con tus valores en el servidor.
# El archivo .env NO se debe subir al repositorio.
# =====================================================================

# Clave secreta del panel (cambiala por una cadena larga y aleatoria).
# Se usa para firmar CSRF, sesiones y cifrar contraseñas de usuarios de BD.
APP_SECRET=

# Zona horaria del panel (ej: America/Lima, UTC)
APP_TIMEZONE=America/Lima

# Nombre/URL base del panel. Deja "/" si se sirve en /, usa "/panel/" si va en subcarpeta.
APP_BASEURL=/

# ---------------------------------------------------------------------
# Base de datos propia del panel (MySQL). Se crea durante la instalación.
# El usuario de la app SOLO tiene acceso a la base <DB_NAME>.
# Todas las operaciones privilegiadas (CREATE USER, GRANT, vhosts...)
# se hacen a través del wrapper privilegiado, NO desde PHP.
# ---------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=miserver
DB_USER=miserver
DB_PASS=

# ---------------------------------------------------------------------
# Ruta del wrapper privilegiado (instalado por el script de instalación).
# ---------------------------------------------------------------------
CTL_PATH=/usr/local/sbin/miserver-ctl

# Directorio de backups (lo usan los scripts de backup y el panel).
BACKUP_DIR=/var/backups/miserver

# Directorio donde se guardan las sesiones del panel (lo crea la instalación).
SESSION_PATH=